---
const { siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="site-title" translate="no">
  <span class="wordmark">TanStack <strong>Query</strong></span>
  <span class="version">v5</span>
</a>
<style>
  .site-title { display: inline-flex; align-items: center; gap: 0.625rem; min-width: 0; color: var(--doc-fg); text-decoration: none; white-space: nowrap; }
  .wordmark { font-size: 1rem; font-weight: 500; letter-spacing: -0.04em; }
  strong { font-weight: 700; }
  .version { padding: 0.125rem 0.375rem; border: 1px solid var(--doc-border); border-radius: 0.375rem; color: var(--doc-muted); font-size: 0.6875rem; line-height: 1.5; }
</style>
