---
import path from 'node:path';
import { editorialMarkdown } from '../../../scripts/docs-markdown.mjs';

const { entry } = Astro.locals.starlightRoute;
const title = entry.data.title;
const isZh = entry.id.startsWith('zh/');
const copyLabel = isZh ? '复制 Markdown' : 'Copy Markdown';
const copiedLabel = isZh ? '已复制！' : 'Copied!';
const editorial = entry.filePath ? editorialMarkdown(path.resolve(entry.filePath)) : '';
const rawMarkdown = [entry.body ?? '', editorial].filter(Boolean).join('\n\n');
const sourceId = `md-source-${entry.id.replace(/[^\w-]+/g, '-')}`;

const frontmatterLines = [`title: ${JSON.stringify(title)}`];
for (const [key, value] of Object.entries(entry.data)) {
  if (key === 'title' || key === 'editUrl') continue;
  if (value === undefined || value === null || value === false) continue;
  frontmatterLines.push(`${key}: ${JSON.stringify(value)}`);
}
const fullMarkdown = `---\n${frontmatterLines.join('\n')}\n---\n\n${rawMarkdown}`;
// Keep JSON safe inside a script tag even when markdown includes "</script>" or similar.
const serializeForScriptTag = (value: string) =>
  JSON.stringify(value)
    .replace(/</g, '\\u003C')
    .replace(/>/g, '\\u003E')
    .replace(/&/g, '\\u0026')
    .replace(/\u2028/g, '\\u2028')
    .replace(/\u2029/g, '\\u2029');
const fullMarkdownJson = serializeForScriptTag(fullMarkdown);
---

<div class="page-heading">
  <p class="eyebrow" translate="no">React <span>v5</span></p>
  <h1 id="_top">{title}</h1>
  <copy-markdown class="page-tools print:hidden">
    <button type="button" class="copy-md-btn" data-source={sourceId}
      data-copy={copyLabel} data-copied={copiedLabel}
      data-error={isZh ? '复制失败，请重试' : 'Copy failed. Please retry.'}>
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="8" y="8" width="12" height="13" rx="2"></rect>
        <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h3"></path>
      </svg>
      <span>{copyLabel}</span>
    </button>
    <span class="copy-status" role="status" aria-live="polite"></span>
  </copy-markdown>
</div>
<script is:inline id={sourceId} type="application/json" set:html={fullMarkdownJson} />

<style>
  .eyebrow { margin: 0 0 0.75rem; color: var(--doc-muted); font-size: 0.75rem; font-weight: 500; }
  .eyebrow span { margin-inline-start: 0.35rem; }
  h1 { margin: 0; font-size: clamp(1.75rem, 1.5rem + 0.7vw, 2.125rem); line-height: 1.3; letter-spacing: -0.035em; font-weight: 650; color: var(--doc-fg); overflow-wrap: anywhere; }
  .page-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 1.25rem; }
  .copy-md-btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.625rem; min-height: 2rem; border: 1px solid var(--doc-border); border-radius: 0.375rem; background: var(--doc-bg); color: var(--doc-muted); font: inherit; font-size: 0.75rem; line-height: 1.5; box-shadow: var(--sl-shadow-sm); cursor: pointer; }
  .copy-md-btn:hover { color: var(--doc-fg); background: var(--doc-surface); }
  .copy-status { font-size: 0.75rem; color: var(--doc-muted); }
  @media (pointer: coarse) { .copy-md-btn { min-height: 2.75rem; } }
</style>

<script>
  class CopyMarkdown extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button');
      const status = this.querySelector('[role="status"]');
      if (!button || !status) return;
      button.onclick = async () => {
        const source = document.getElementById(button.dataset.source ?? '');
        if (!source) return;
        button.disabled = true;
        try {
          const markdown: string = JSON.parse(source.textContent ?? '""');
          await navigator.clipboard.writeText(markdown);
          status.textContent = button.dataset.copied ?? '';
        } catch {
          status.textContent = button.dataset.error ?? '';
        } finally {
          button.disabled = false;
        }
      };
    }
  }
  if (!customElements.get('copy-markdown')) customElements.define('copy-markdown', CopyMarkdown);
</script>
